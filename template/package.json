{
  "description": "FrontDesk — config-driven AI front desk template (Kiroween 2026, Skeleton Crew). No build step; JSON-file store by default, optional Postgres backend via the 'pg' package when DATABASE_URL is set.",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "main": "server.js",
  "name": "frontdesk-template",
  "private": true,
  "dependencies": {
    "pg": "^8.13.0"
  },
  "scripts": {
    "cli": "node cli.js",
    "generate": "node generate.js",
    "start": "node server.js --config ../config/fixit-auto.json --port 3000",
    "start:auto": "node server.js --config ../config/fixit-auto.json --port 3001",
    "start:dental": "node server.js --config ../config/brightsmile-dental.json --port 3002",
    "test": "node --test \"tests/*.test.js\""
  },
  "version": "0.1.0"
}
