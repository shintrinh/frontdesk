{"$id":"https://github.com/shintrinh/frontdesk/config/schema.json","$schema":"http://json-schema.org/draft-07/schema#","description":"One JSON file fully describes a front desk app. The Kiro spec reads this file and the vertical-generator scaffolds a working app from it. All fields below are required unless marked optional.","properties":{"business":{"properties":{"address":{"type":"string"},"hours":{"properties":{"close":{"pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$","type":"string"},"days":{"description":"JavaScript getDay() convention: 0 = Sunday, 6 = Saturday","items":{"maximum":6,"minimum":0,"type":"integer"},"type":"array"},"open":{"pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$","type":"string"}},"required":["open","close","days"],"type":"object"},"name":{"minLength":1,"type":"string"},"phone":{"type":"string"},"timezone":{"description":"IANA timezone, e.g. America/New_York","type":"string"},"type":{"enum":["auto-repair","dental-clinic","vet-clinic","salon","cafe","other"],"type":"string"}},"required":["name","type","timezone"],"type":"object"},"channels":{"items":{"enum":["voice","sms","email"],"type":"string"},"minItems":1,"type":"array"},"estimate":{"properties":{"dataset":{"description":"Path to the named dataset backing estimates, relative to repo root","type":"string"},"enabled":{"type":"boolean"},"rule":{"description":"Human-readable rule, e.g. service + symptom -> price range + time range","type":"string"}},"required":["enabled"],"type":"object"},"intakeFields":{"description":"Fields the front desk collects at booking time","items":{"type":"string"},"type":"array"},"intakeOptional":{"description":"Subset of intakeFields that may be left blank","items":{"type":"string"},"type":"array"},"language":{"const":"en","description":"All FrontDesk output is English","type":"string"},"reminders":{"properties":{"confirmHoursBefore":{"minimum":0,"type":"number"},"recallDays":{"anyOf":[{"type":"null"},{"minimum":1,"type":"integer"}],"description":"Null when the vertical has no recall cycle (e.g. auto repair)"}},"required":["confirmHoursBefore"],"type":"object"},"services":{"items":{"properties":{"codes":{"description":"Optional procedure codes, e.g. ADA CDT codes for dental","items":{"type":"string"},"type":"array"},"description":{"type":"string"},"durationMin":{"minimum":15,"type":"integer"},"id":{"pattern":"^[a-z0-9-]+$","type":"string"},"name":{"minLength":1,"type":"string"},"priceEstimate":{"anyOf":[{"description":"No price shown (e.g. dental: fees vary by insurance)","type":"null"},{"properties":{"max":{"minimum":0,"type":"number"},"min":{"minimum":0,"type":"number"}},"required":["min","max"],"type":"object"}]}},"required":["id","name","durationMin"],"type":"object"},"minItems":1,"type":"array"}},"required":["business","services","intakeFields","estimate","reminders","channels"],"title":"FrontDesk business config (schema v0)","type":"object"}